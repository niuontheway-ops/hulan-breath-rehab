.music-scene{width:100%;height:360rpx;border-radius:28rpx;margin:8rpx 0 28rpx}.now-playing{font-size:46rpx;line-height:1.5;font-weight:750;margin-bottom:12rpx}.senior .now-playing{font-size:52rpx}.music-status{margin-top:26rpx;min-height:94rpx;word-break:break-word}.volume-row{margin-top:32rpx}.volume-row>text{font-size:28rpx;color:#4e655f}.senior .volume-row>text{font-size:36rpx}.track-row{display:block;width:100%;text-align:left;background:none;border-radius:0;padding:26rpx 12rpx;border-bottom:1rpx solid #cbdccd;min-height:135rpx;transition:transform .15s,box-shadow .15s}.track-row.selected{background:#deebe0;border-left:6rpx solid #185b50;padding-left:22rpx}.track-title{font-size:34rpx;font-weight:650;margin-bottom:8rpx;display:flex;gap:20rpx;align-items:center;justify-content:space-between}.senior .track-title{font-size:42rpx}.track-selection{font-size:25rpx;color:#285b48;flex-shrink:0}.senior .track-selection{font-size:31rpx}.music-privacy{margin-top:32rpx}.training-entry{margin-top:30rpx}

.senior .now-playing{font-size:26px}.senior .track-title{font-size:22px}.senior .track-selection{font-size:18px}.senior .volume-row>text{font-size:20px}
