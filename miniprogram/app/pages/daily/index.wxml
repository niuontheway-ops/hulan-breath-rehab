<view class="page {{senior?'senior':''}} {{reducedMotion?'reduced-motion':''}}">
  <view class="page-title">今天感觉怎样？</view><view class="field-help">{{day}} · 仅保存在这部手机</view>
  <view class="error" wx:if="{{storageError}}">{{storageError}}</view><view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="status danger" wx:if="{{urgent}}"><view class="status-title">先停止训练，寻求医疗帮助</view><view>严重胸痛、气促、晕厥或明显咯血时，立即让身边的人协助，必要时拨打 120。</view></view>
  <view wx:if="{{saved}}"><view class="status {{outcome.status==='urgent'?'danger':outcome.status==='review'?'warning':''}}"><view class="status-title">{{outcome.title}}</view><view>{{outcome.message}}</view><view wx:for="{{outcome.reasons}}" wx:key="*this" class="bullet">{{item}}</view></view><button class="btn-primary" bindtap="done" hover-class="press-lift">查看本机记录</button></view>
  <block wx:else>
    <view class="step-count">第 {{step+1}} / 3 步</view>
    <block wx:if="{{step===0}}"><image class="section-image" src="/assets/chapters/daily.svg" mode="aspectFit" /><view class="field"><view class="field-label">记录哪个主题？</view><picker range="{{topics}}" value="{{topicIndex}}" bindchange="topicChange"><view class="input">{{topics[topicIndex]}}</view></picker></view><view class="section-title">与平常相比</view><view class="options"><button class="option {{statusComparedUsual==='usual'?'selected':''}}" data-field="statusComparedUsual" data-value="usual" bindtap="choice" hover-class="press-lift">和平常差不多</button><button class="option {{statusComparedUsual==='worse'?'selected':''}}" data-field="statusComparedUsual" data-value="worse" bindtap="choice" hover-class="press-lift">比平常更差</button><button class="option {{statusComparedUsual==='unknown'?'selected':''}}" data-field="statusComparedUsual" data-value="unknown" bindtap="choice" hover-class="press-lift">还不确定</button></view>
      <view class="field"><view class="field-label">年龄范围</view><view class="button-row"><button class="option {{ageGroup==='adult'?'selected':''}}" data-field="ageGroup" data-value="adult" bindtap="choice">18 岁及以上</button><button class="option {{ageGroup==='minor'?'selected':''}}" data-field="ageGroup" data-value="minor" bindtap="choice">未满 18 岁</button></view></view><view class="field" wx:if="{{topic!=='quit'}}"><view class="field-label">这个疾病已由医护确认吗？</view><view class="button-row"><button class="option {{diagnosisConfirmed===true?'selected':''}}" data-field="diagnosisConfirmed" data-value="yes" bindtap="choice">已确认</button><button class="option {{diagnosisConfirmed===false?'selected':''}}" data-field="diagnosisConfirmed" data-value="no" bindtap="choice">还没有</button></view></view>
    </block>
    <block wx:elif="{{step===1}}"><view class="page-intro">0 表示没有，10 表示最严重。选择你今天的感受。</view><view class="field"><view class="field-label">今天的气促（0–10）</view><picker range="{{ratingLabels}}" value="{{breathlessness===null?0:breathlessness+1}}" data-field="breathlessness" bindchange="rating"><view class="input">{{breathlessness===null?'请选择':breathlessness+' 分'}}</view></picker></view><view class="field"><view class="field-label">今天的疲劳（0–10）</view><picker range="{{ratingLabels}}" value="{{fatigue===null?0:fatigue+1}}" data-field="fatigue" bindchange="rating"><view class="input">{{fatigue===null?'请选择':fatigue+' 分'}}</view></picker></view><button class="link-button" bindtap="toggleExtra">{{extra?'收起':'选填'}}血氧与已有量表</button><view wx:if="{{extra}}" class="panel"><view class="field"><view class="field-label">静息 SpO₂（%）</view><input class="input" type="digit" value="{{spo2}}" data-field="spo2" bindinput="setField" placeholder="没测可留空" /></view><view class="field" wx:if="{{topic==='asthma'}}"><view class="field-label">ACT 已有总分（5–25）</view><input class="input" type="number" value="{{act}}" data-field="act" bindinput="setField" /></view><view class="field" wx:if="{{topic==='copd'}}"><view class="field-label">CAT 已有总分（0–40）</view><input class="input" type="number" value="{{cat}}" data-field="cat" bindinput="setField" /></view><view class="field" wx:if="{{topic==='osa'}}"><view class="field-label">ESS 已有总分（0–24）</view><input class="input" type="number" value="{{ess}}" data-field="ess" bindinput="setField" /></view><view class="field" wx:if="{{topic==='quit'}}"><view class="field-label">FTND 已有总分（0–10）</view><input class="input" type="number" value="{{ftnd}}" data-field="ftnd" bindinput="setField" /></view><view class="field"><view class="field-label">量表实际完成日期</view><picker mode="date" value="{{scoreDate}}" end="{{day}}" bindchange="scoreDateChange"><view class="input">{{scoreDate}}</view></picker></view><view class="field-help">只记录已有结果，不把旧量表当作今天刚测。</view></view></block>
    <block wx:else><button class="btn-quiet" bindtap="noFlags" hover-class="press-lift">以上危险症状都没有</button><view wx:for="{{flagRows}}" wx:key="id" class="field"><view class="field-label">{{item.label}}</view><view class="button-row"><button class="option {{item.value===true?'selected':''}}" data-group="redFlags" data-id="{{item.id}}" data-value="yes" bindtap="flag">有</button><button class="option {{item.value===false?'selected':''}}" data-group="redFlags" data-id="{{item.id}}" data-value="no" bindtap="flag">没有</button></view></view><view class="field"><view class="field-label">痰量或颜色有变化吗？</view><view class="button-row"><button class="option {{sputumChange===true?'selected':''}}" data-field="sputumChange" data-value="yes" bindtap="choice">有变化</button><button class="option {{sputumChange===false?'selected':''}}" data-field="sputumChange" data-value="no" bindtap="choice">没有变化</button></view></view><block wx:if="{{topic==='tb'}}"><button class="btn-quiet" bindtap="noTb">下面症状都没有</button><view wx:for="{{tbRows}}" wx:key="id" class="field"><view class="field-label">{{item.label}}</view><view class="button-row"><button class="option {{item.value===true?'selected':''}}" data-group="tbSymptoms" data-id="{{item.id}}" data-value="yes" bindtap="flag">有</button><button class="option {{item.value===false?'selected':''}}" data-group="tbSymptoms" data-id="{{item.id}}" data-value="no" bindtap="flag">没有</button></view></view></block></block>
    <view class="button-row"><button wx:if="{{step>0}}" class="btn-secondary" bindtap="previous" hover-class="press-lift">上一步</button><button class="btn-primary" bindtap="next" hover-class="press-lift">{{step===2?'保存今日评估':'下一步'}}</button></view>
  </block>
</view>
