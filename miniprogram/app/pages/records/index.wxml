<view class="page {{senior?'senior':''}} {{reducedMotion?'reduced-motion':''}}"><view class="page-title">留住每天的小进步</view><view class="page-intro">记录保存在当前微信的本机空间。</view><view class="error" wx:if="{{storageError}}">{{storageError}}</view><view class="button-row record-tabs"><button class="option {{active==='daily'?'selected':''}}" data-id="daily" bindtap="select">每日评估</button><button class="option {{active==='sessions'?'selected':''}}" data-id="sessions" bindtap="select">训练记录</button></view>
  <block wx:if="{{active==='daily'}}"><view class="empty" wx:if="{{!daily.length}}">还没有每日评估。<button class="btn-primary" bindtap="newDaily" hover-class="press-lift">记录今天的状态</button></view><view wx:for="{{daily}}" wx:key="id" class="panel"><view class="field-help">{{item.day}}</view><view class="section-title">{{item.label}}</view><view class="row"><text>气促 {{item.breathlessness}} / 10</text><text>疲劳 {{item.fatigue}} / 10</text></view><view class="status {{item.outcome.status==='urgent'?'danger':item.outcome.status==='review'?'warning':''}}"><view class="status-title">{{item.outcome.title}}</view><view wx:for="{{item.outcome.reasons}}" wx:for-item="reason" wx:key="*this">{{reason}}</view></view><view class="field-help" wx:if="{{item.spo2!==null}}">静息 SpO₂ {{item.spo2}}%</view></view></block>
  <block wx:else><view class="empty" wx:if="{{!sessions.length}}">还没有训练记录。<button class="btn-primary" bindtap="start" hover-class="press-lift">查看训练条件</button></view><view class="panel" wx:for="{{sessions}}" wx:key="id"><view class="field-help">{{item.day}}</view><view class="section-title">{{item.label}}</view><view>已亲自确认 {{item.completedCycles}} 轮</view><view class="field-help">引导计时 {{item.minutes}} 分钟 · {{item.statusLabel}}</view><view class="field-help">这是用户确认记录，不是传感器测量的呼吸量或训练效果。</view></view></block>
  <view class="panel-quiet"><button class="link-button" bindtap="reports">本机报告文件</button><button class="link-button" bindtap="settings">显示与数据设置</button></view>
</view>
