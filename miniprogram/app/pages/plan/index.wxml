<view class="page {{senior?'senior':''}} {{reducedMotion?'reduced-motion':''}}"><image class="section-image" src="/assets/chapters/plan.svg" mode="aspectFit" /><view class="page-title">你的康复安排</view><view class="error" wx:if="{{storageError}}">{{storageError}}</view>
  <view wx:if="{{!plan}}" class="panel"><view class="section-title">先认识当前状态</view><view>从年龄和疾病开始，专业评分不会填可跳过。</view><button class="btn-primary" bindtap="edit" hover-class="press-lift">填写健康评估</button></view>
  <block wx:else><view class="status {{plan.status==='urgent'?'danger':plan.status==='ready'?'':'warning'}}"><view class="status-title">{{plan.title}}</view><view>{{plan.subtitle}}</view></view><view class="bullet" wx:for="{{plan.reasons}}" wx:key="*this">{{item}}</view>
    <block wx:if="{{plan.status==='ready'}}"><view class="status warning">下方是康复教育起步内容，不是设备处方。请与医护确认，随时按身体感受暂停。</view><view wx:for="{{plan.sessions}}" wx:key="id" class="panel"><view class="section-title">{{item.title}}</view><view>{{item.instruction}}</view><view class="field-help">{{item.intensity}}</view><view class="field-help">{{item.frequency}}</view></view><button class="btn-primary" bindtap="train" hover-class="press-lift" disabled="{{!!storageError}}">进入呼吸训练</button></block>
    <block wx:else><button class="btn-secondary" bindtap="edit" hover-class="press-lift">补充或修改评估</button><button class="link-button" bindtap="learn">先看疾病宣教</button></block>
    <button class="link-button" bindtap="toggleDetails">{{details?'收起':'查看'}}安全提示与依据</button><view wx:if="{{details}}" class="panel"><view class="bullet" wx:for="{{plan.warnings}}" wx:key="*this">{{item}}</view><view class="section-title">资料来源</view><button wx:for="{{plan.sourceLinks}}" wx:key="url" class="link-button" data-url="{{item.url}}" bindtap="copySource">{{item.label}}（复制链接）</button></view>
  </block>
</view>
